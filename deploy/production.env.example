# Copy to deploy/production.env; keep actual credentials outside Git.
RELEASE_TAG=enterprise-security-20261112
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
APP_ENV=production
DEMO_MODE=false
BACKGROUND_EXECUTION_MODE=external
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
GITHUB_WEBHOOK_SECRET=
CORS_ORIGINS=https://codepilot.example.com
OUTBOUND_ALLOWED_HOSTS=api.github.com,github.com,codeload.github.com,api.deepseek.com,dashscope.aliyuncs.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
CONTEXT_RESERVED_RESPONSE_TOKENS=3000
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
DASHSCOPE_API_KEY=
RERANK_BASE_URL=
RERANK_API_KEY=
MILVUS_ENABLED=true
# Configure a rotated application identity, not the factory root password.
MILVUS_TOKEN=
MILVUS_ROOT_PASSWORD=
MILVUS_APP_PASSWORD=
AI_REQUESTS_PER_HOUR=60
AI_GLOBAL_REQUESTS_PER_HOUR=300
MAX_DOCUMENT_CHUNKS=500
MAX_EVAL_CASES=20
MAX_EVAL_TOKENS=1000000
MAX_SNAPSHOT_CHUNKS=2000
MAX_KNOWLEDGE_SNAPSHOTS=10
RELEASE_GATE_REQUIRED=false
RELEASE_GATE_EVAL_ID=
AI_CONCURRENT_REQUESTS=2
REQUESTS_PER_MINUTE=120
CI_SANDBOX_ENABLED=false
# Generate a 32-byte URL-safe base64 key and store its backup separately.
BACKUP_ENCRYPTION_KEY=
